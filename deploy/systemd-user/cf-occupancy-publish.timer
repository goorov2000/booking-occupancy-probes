[Unit]
Description=CF: публикация страниц загрузки глэмпингов раз в сутки (user)

[Timer]
# Прогон стартует в 06:30; с 08.09.2026 у него дедлайн 150 минут (третий
# трек целей — топ-50 глэмпингов России), то есть закрыться он обязан к 09:15.
# 09:45 даёт запас на хвост прогона (сводка, слой сезонности, Run Log).
# Скрипт сам не публикует, если прогон не закрыт.
OnCalendar=*-*-* 09:45:00
RandomizedDelaySec=300
Persistent=true
Unit=cf-occupancy-publish.service

[Install]
WantedBy=timers.target
