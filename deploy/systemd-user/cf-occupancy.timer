[Unit]
Description=CF: снимок загрузки глэмпингов раз в сутки (user)

[Timer]
# Раз в сутки рано утром: календари чужих модулей меняются в течение дня, и
# фиксированный ранний час даёт чистую суточную дельту «что добронировали».
# Час здесь — ПЛАНОВЫЙ МОМЕНТ прогона: run_scheduled считает от него gap_days
# снимка (--planned-time, дефолт 06:30). Меняется парой: тут и там, иначе
# догоняющий прогон запишется как снятый вовремя.
OnCalendar=*-*-* 06:30:00
# Разброс до 15 минут: полсотни объектов, незачем стучаться к ним ровно по
# будильнику.
RandomizedDelaySec=900
# Машина спала или прогон пропущен — догнать при ближайшей возможности:
# пропущенный день рвёт ряд динамики, а ряд и есть смысл слежки.
Persistent=true
Unit=cf-occupancy.service

[Install]
WantedBy=timers.target
