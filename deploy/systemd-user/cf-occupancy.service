[Unit]
# Витрина: пути ниже — плейсхолдеры (/home/<user>/booking-occupancy-probes);
# OnFailure=cf-alert@ ссылается на уведомитель внешнего контура, в репозиторий не входит.
# Снимок загрузки глэмпингов: пробники по всем целям targets.json, один
# каталог снапшота, пересборка сводки. Точка входа — run_scheduled.py скилла
# /glamping-occupancy (там же написано, чего таймер НЕ делает: не разведывает
# объекты, не ходит браузером на агрегаторы и не публикует артефакт —
# инструмент публикации есть только у агента).
#
# СТАВИТСЯ СИМЛИНКОМ, не копией:
#   ln -sf /home/<user>/booking-occupancy-probes/deploy/systemd-user/cf-occupancy.service \
#          ~/.config/systemd/user/ && systemctl --user daemon-reload
# Копия уже стоила инцидента: 04.09 в репозитории подняли TimeoutStartSec до
# 120 мин, а на машине лежала копия с 60 мин — то есть новый код завтра
# выполнился бы под старым потолком, и SIGTERM прилетел бы РАНЬШЕ собственного
# дедлайна прогона (90 мин), оставив снапшот незакрытым. Правка в репозитории,
# которая молча не доезжает до машины, хуже отсутствия правки.
#
# Юнит user-level по образцу cf-hiring-sync: root ему не нужен, а ставить его
# в системный контур нельзя — там таймеры завода, выключенные паузой 13.08, и
# отдельная слежка за загрузкой не должна ни зависеть от этой паузы, ни быть
# случайно включённой вместе с заводом. Модель он не тратит: только чужие
# модули бронирования обычным HTTP с паузами >= 1.2 с на хост.
Description=CF: снимок загрузки глэмпингов (user)
After=network-online.target
OnFailure=cf-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/<user>/booking-occupancy-probes
Environment=PATH=/home/<user>/.local/bin:/usr/local/bin:/usr/bin:/bin
Nice=10
# Два часа (волна 2, 04.09.2026). Горизонт сетки стал скользящим годом вместо
# фиксированных трёх месяцев, целей стало 53 вместо 25, а фонд домиков у
# TravelLine, Bnovo и UHotels стоит запроса на КАЖДУЮ ночь при паузе >= 1.2 с
# к одному хосту. Прежних 60 минут не хватало: systemd убивал прогон раньше,
# чем срабатывал его собственный дедлайн, и снапшот оставался без закрытия.
#
# Это ПОТОЛОК аварийного отруба, а не рабочее окно: прогон режет себя сам
# дедлайном 90 мин (run_scheduled.DEFAULT_DEADLINE_MIN), а оставшиеся полчаса —
# запас на хвост, который идёт уже ПОСЛЕ съёма: сводка, слой сезонности,
# телеграм и строка в Run Log. Значения двигать парой: таймаут всегда заметно
# больше дедлайна, иначе SIGTERM снова прилетит раньше штатного закрытия.
# 08.09.2026: 120 -> 180 мин вместе с дедлайном 90 -> 150 (третий трек
# целей — топ-50 глэмпингов России; см. run_scheduled.DEFAULT_DEADLINE_MIN).
TimeoutStartSec=180min
ExecStart=/home/<user>/booking-occupancy-probes/.venv/bin/python /home/<user>/booking-occupancy-probes/occupancy/run_scheduled.py
