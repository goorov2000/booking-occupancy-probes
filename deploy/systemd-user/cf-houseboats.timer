[Unit]
Description=CF: снимок занятости хаусботов раз в неделю (user)

[Timer]
# Воскресенье 04:00: недельный ритм (прозвон идёт раз в неделю, модулей брони
# у хаусботов почти нет), раннее утро — чтобы календари не менялись под съёмом.
# Плановый час — PLANNED_TIME в run_houseboats.sh; менять парой.
#
# ПОЧЕМУ НЕ 07:00 (было так до 14.09.2026). Замок живого съёма один на МАШИНУ
# (occupancy_core.host_lock_path): он защищает не файлы, а чужие хосты — паузу
# >= 1.2 с к хосту два процесса не делят. Глэмпинговый прогон стартует в 06:30
# (+ джиттер 15 мин) и идёт всё дольше: 55 мин в начале сентября, 103 мин
# 13.09 при собственном дедлайне 150. Хаусботы в 07:00 попадали внутрь этого
# окна ВСЕГДА, упирались в замок и падали с кодом 2 — прогон 13.09 так и
# записан в Run Log как failed, а до него единственный другой был
# insufficient_data. То есть недельный контур не отработал ни разу.
# 04:00 + джиттер 10 мин даёт дедлайн хаусботов (60 мин) закончиться к 05:10,
# за час с лишним до старта глэмпингов. Двигать этот час можно только вместе с
# OnCalendar в cf-occupancy.timer: между концом хаусботов и стартом глэмпингов
# должен оставаться зазор больше, чем дедлайн хаусботов.
OnCalendar=Sun *-*-* 04:00:00
RandomizedDelaySec=600
Persistent=true
Unit=cf-houseboats.service

[Install]
WantedBy=timers.target
